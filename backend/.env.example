# ============ 服务器（H20 单卡）============
# 推理服务地址（vLLM OpenAI 兼容端点）
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# 模型名（与 vLLM --served-model-name 一致）
LLM_MODEL=gi-assistant
LLM_API_KEY=EMPTY

# ============ 本地开发 ============
# LLM_STUB=1 时不调用真实模型，返回占位文本（无 GPU 环境跑通全链路）
LLM_STUB=0

# 数据目录（文件夹存储）
GI_DATA_DIR=./data
# 提示词模板目录
GI_PROMPTS_DIR=./backend/prompts

# 上下文组装预算
MAX_CONTEXT_TOKENS=16000
RECENT_DOCS_FULL=3
RECENT_LABS=20
MAX_EXAMPLES=2
MAX_CHAT_HISTORY=8

# 采样参数
TEMP_DRAFT=0.3
TEMP_PLAN=0.4
MAX_TOKENS=4096

# 后端监听
GI_HOST=0.0.0.0
GI_PORT=8100
